# Large Twenty core directories we never modify
# (read these only when doing an upstream merge)
packages/twenty-front/src/pages/settings/
packages/twenty-front/src/modules/workflow/
packages/twenty-front/src/modules/auth/
packages/twenty-front/src/modules/ui/
packages/twenty-server/src/engine/core-modules/
