# Claude Code ignore file
# Files listed here are excluded from Claude's context window but remain in git.
# To restore visibility: remove the entry from this file.

# Twenty packages kept in git but not relevant to POP Creations development
packages/twenty-companion/
packages/twenty-sdk/
packages/twenty-client-sdk/
packages/twenty-front-component-renderer/
packages/twenty-oxlint-rules/
packages/twenty-zapier/
packages/twenty-website/
